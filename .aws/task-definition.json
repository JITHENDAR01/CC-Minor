{
  "family": "campusconnect-cluster-campusconnect-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "PLACEHOLDER_EXECUTION_ROLE",
  "taskRoleArn": "PLACEHOLDER_TASK_ROLE",
  "containerDefinitions": [
    {
      "name": "campusconnect-service",
      "image": "513263709519.dkr.ecr.eu-north-1.amazonaws.com/campusconnect:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "secrets": [],
      "environment": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/campusconnect",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
